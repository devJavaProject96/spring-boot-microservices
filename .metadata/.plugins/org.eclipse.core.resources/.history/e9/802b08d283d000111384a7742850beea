package com.dasTech.service;

import java.util.Collections;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.security.core.userdetails.UserDetails;
import org.springframework.security.core.userdetails.UserDetailsService;
import org.springframework.security.core.userdetails.UsernameNotFoundException;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;

import com.dasTech.entity.User;
import com.dasTech.repository.UserRepo;

@Service
public class UserService implements UserDetailsService {

	@Autowired
	private UserRepo userRepo;
	@Autowired
	private PasswordEncoder pwdEncoder;

	@Override
	public UserDetails loadUserByUsername(String username) throws UsernameNotFoundException {
		User dbUser = userRepo.findByEmail(username);

		if (dbUser == null) {
			return ResponseEntity.status(HttpStatus.UNAUTHORIZED).body("Email not found in database");
		}

		System.out.println("Email found: " + dbUser.getEmail());
		System.out.println("Password matches: " + pwdEncoder.matches(username, dbUser.getPassword()));

		return org.springframework.security.core.userdetails.User.withUsername(user.getEmail())
				.password(user.getPassword()).authorities(Collections.emptyList()).build();
	}

}